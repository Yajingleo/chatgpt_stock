# Main BUILD file for the stock analysis project

load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])


# Main agent library - aggregates all submodules
py_library(
    name = "agent",
    srcs = glob(["agent/**/*.py"]),
    imports = ["."],
    deps = [
        requirement("pandas"),
        requirement("numpy"),
        requirement("scipy"),
        requirement("yfinance"),
        requirement("requests"),
        requirement("beautifulsoup4"),
        requirement("openai"),
        requirement("python-dotenv"),
        "//agent/data:data",
        "//agent/utils:utils",
    ],
)

# Web server
py_library(
    name = "web_lib",
    srcs = glob(["web/**/*.py"]),
    imports = ["."],
    deps = [
        ":agent",
    ],
)

py_binary(
    name = "web_server",
    srcs = ["web/server.py"],
    main = "web/server.py",
    imports = ["."],
    deps = [":web_lib"],
)

# Example scripts
py_binary(
    name = "agent_example",
    srcs = ["scripts/examples/agent_example.py"],
    main = "scripts/examples/agent_example.py",
    imports = ["."],
    deps = [":agent"],
)

py_binary(
    name = "launch_server",
    srcs = ["scripts/launch_server.py"],
    main = "scripts/launch_server.py",
    imports = ["."],
    deps = [
        ":agent",
        ":web_lib",
    ],
)

# Diagnostic scripts
py_binary(
    name = "diag_openai",
    srcs = ["scripts/diagnostics/diag_openai.py"],
    main = "scripts/diagnostics/diag_openai.py",
    imports = ["."],
    deps = [
        requirement("openai"),
        requirement("python-dotenv"),
    ],
)

py_binary(
    name = "test_yfinance",
    srcs = ["scripts/diagnostics/test_yfinance.py"],
    main = "scripts/diagnostics/test_yfinance.py",
    imports = ["."],
    deps = [
        requirement("yfinance"),
        requirement("pandas"),
    ],
)

