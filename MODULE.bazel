module(
    name = "stock_analysis",
    version = "1.0.0",
)

# Python rules
bazel_dep(name = "rules_python", version = "0.40.0")

# Python dependencies - simple requirements file
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "stock_analysis_pip",
    python_version = "3.11", 
    requirements_lock = "//:requirements-simple.txt",
)
use_repo(pip, "stock_analysis_pip")

# Gazelle for auto-generation
bazel_dep(name = "gazelle", version = "0.35.0")

# Go rules (if needed later)
# bazel_dep(name = "rules_go", version = "0.46.0")
