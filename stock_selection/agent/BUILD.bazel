# Stock selection agent components (Bzlmod)

load("@rules_python//python:defs.bzl", "py_library")

# News crawler agent - basic version without external deps
py_library(
    name = "news_crawler_agent",
    srcs = ["news_crawler_agent.py"],
    visibility = ["//visibility:public"],
)

# Sentiment analyzer - basic version without external deps
py_library(
    name = "sentiment_analyzer",
    srcs = ["sentiment_analyzer.py"],
    visibility = ["//visibility:public"],
)

# Stock recommender
py_library(
    name = "stock_recommender",
    srcs = ["stock_recommender.py"],
    visibility = ["//visibility:public"],
)

# Main ADK stock agent
py_library(
    name = "adk_stock_main_agent",
    srcs = ["adk_stock_main_agent.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":news_crawler_agent",
        ":sentiment_analyzer",
        ":stock_recommender",
    ],
)